{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": { "IncludeScopes": true, "UseUtcTimestamp": true }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Kyc": "Host=localhost;Port=5432;Database=kyc;Username=kyc;Password=kyc"
  },
  "Kyc": {
    "Roles": "api,worker",
    "SessionLifetimeMinutes": 1440,
    "HandoffTtlSeconds": 300,
    "HandoffBaseUrl": "http://localhost:3000/verify/continue"
  },
  "Database": { "MigrateOnStartup": true },
  "Storage": {
    "Bucket": "kyc-artifacts",
    "ServiceUrl": "http://localhost:9000",
    "PublicServiceUrl": "http://localhost:9000",
    "AccessKey": "kyc-s3-access",
    "SecretKey": "kyc-s3-secret-dev-only",
    "EnsureBucketOnStartup": true,
    "UploadUrlTtlSeconds": 300,
    "DownloadUrlTtlSeconds": 120,
    "MaxUploadBytes": 10485760
  },
  "Security": {
    "_comment": "DEV-ONLY keys. Production keys come from a KMS / secrets manager and are never committed.",
    "FieldEncryptionKey": "ZGV2LW9ubHktZmllbGQtZW5jcnlwdGlvbi1rZXktMzI=",
    "KeyId": 1,
    "IdentifierHmacKey": "ZGV2LW9ubHktaWRlbnRpZmllci1obWFjLXBlcHBlcg=="
  },
  "ApiClients": [
    { "ClientId": "onboarding-web", "Key": "dev-partner-key", "Roles": [ "partner" ] },
    { "ClientId": "ops-reviewer-1", "Key": "dev-reviewer-key", "Roles": [ "reviewer" ] }
  ],
  "Providers": {
    "Document": "mock",
    "Liveness": "mock",
    "FaceMatch": "mock",
    "Mock": { "LatencyMs": 300 },
    "Resilience": { "TimeoutSeconds": 15, "CircuitFailureRatio": 0.5, "CircuitMinimumThroughput": 10, "CircuitBreakSeconds": 30 }
  },
  "Decisioning": {
    "FaceMatchApproveThreshold": 0.85,
    "FaceMatchRejectThreshold": 0.60,
    "LivenessApproveThreshold": 0.80,
    "MaxSessionsPerIpPerDay": 10,
    "RulesVersion": "rules-2026.11.1"
  },
  "Worker": { "PollIntervalMs": 500, "BatchSize": 10, "MaxConcurrency": 4, "LeaseSeconds": 60 },
  "RateLimits": { "HandoffRedeemPerMinute": 10 },
  "Retention": { "ImageRetentionDays": 30, "SweepIntervalSeconds": 60 }
}
